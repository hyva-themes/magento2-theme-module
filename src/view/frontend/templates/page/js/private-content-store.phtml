declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var HyvaCsp $hyvaCsp */
?>
<script>
    (() => {
        <?php
        /**
         * Alpine store with the section data of the private-content-loaded event.
         * The event stays the primary API, the store is an opt-in alternative for components
         * that prefer reactive data over an event listener, e.g. $store.privateContent.data.cart
         *
         * `loaded` is false until the first private-content-loaded event, so a component can tell
         * the real section data apart from the empty initial state.
         *
         * Section data that arrives before alpine:init is kept, so the store starts with it.
         */
        ?>
        let pending = null;

        window.addEventListener('alpine:init', () => {
            Alpine.store('privateContent', {
                loaded: pending !== null,
                data: pending || {}
            });
            pending = null;
        }, { once: true });

        window.addEventListener('private-content-loaded', (event) => {
            let data;

            <?php
            /**
             * The event data is copied, because the dispatcher and other listeners mutate the
             * same object after dispatch (e.g. the persisted messages are cleared).
             * JSON is used over structuredClone, since processSectionDataBeforeDispatch can return a Proxy.
             */
            ?>
            try {
                data = JSON.parse(JSON.stringify(event.detail.data || {}));
            } catch (error) {
                console.warn("Couldn't update the privateContent store", error);
                return;
            }

            const store = window.Alpine && Alpine.store('privateContent');
            if (!store) {
                pending = data;
                return;
            }

            store.data = data;
            store.loaded = true;
        });
    })();
    //# sourceURL=hyva-private-content-store.js
</script>
<?php $hyvaCsp->registerInlineScript() ?>
